<?php

	/**
	 * phpPgAdmin config for DirectAdmin plugin.
	 * Community fork: https://github.com/ReimuHakurei/phpPgAdmin
	 * PHP 8.2 / 8.3 / 8.4
	 */

	$conf['servers'][0]['desc'] = 'PostgreSQL';
	$conf['servers'][0]['host'] = 'localhost';
	$conf['servers'][0]['port'] = 5432;
	$conf['servers'][0]['sslmode'] = 'prefer';
	$conf['servers'][0]['pg_dump_path'] = '/usr/bin/pg_dump';
	$conf['servers'][0]['pg_dumpall_path'] = '/usr/bin/pg_dumpall';

	$post_database = (isset($_POST['database']) && $_POST['database'] !== '') ? $_POST['database'] : null;
	$post_login = (isset($_POST['loginUsername']) && $_POST['loginUsername'] !== '') ? $_POST['loginUsername'] : null;
	$conf['servers'][0]['defaultdb'] = $post_database ? $post_database : ($post_login ? $post_login : 'postgres');

	$cookie_secure = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off');
	$sso_cookie = function ($name, $value, $expire) use ($cookie_secure) {
		$opts = array(
			'expires'  => $expire,
			'path'     => '/phppgadmin',
			'secure'   => $cookie_secure,
			'httponly' => true,
			'samesite' => 'Lax',
		);
		@setcookie($name, $value, $opts);
	};

	if ($post_login)
	{
		if (preg_match('/^([A-Za-z0-9]+)_sso_(\d+)$/', $post_login, $m))
		{
			$sso_user = $m[1];
			if ($post_database && (strpos($post_database, $sso_user.'_') === 0 || $post_database === $sso_user))
			{
				define('SSO_USERNAME', $sso_user);
				$remote = isset($_SERVER['REMOTE_ADDR']) ? $_SERVER['REMOTE_ADDR'] : '';
				$server = isset($_SERVER['SERVER_NAME']) ? $_SERVER['SERVER_NAME'] : '';
				$sso_token = hash('sha256', $sso_user . ':'. $server. ':'. $remote.':'. $post_login);
				$exp = time()+43200;
				$sso_cookie('sso_lusername', $post_login, $exp);
				$sso_cookie('sso_username', $sso_user, $exp);
				$sso_cookie('sso_token', $sso_token, $exp);
			}
		}
		else
		{
			$sso_cookie('sso_lusername', '', time()-31536000);
			$sso_cookie('sso_username', '', time()-31536000);
			$sso_cookie('sso_token', '', time()-31536000);
		}
	}
	elseif (isset($_GET['action']) && ($_GET['action'] == 'logout'))
	{
		$sso_cookie('sso_lusername', '', time()-31536000);
		$sso_cookie('sso_username', '', time()-31536000);
		$sso_cookie('sso_token', '', time()-31536000);
	}
	else
	{
		$sso_login = (isset($_COOKIE['sso_lusername']) && $_COOKIE['sso_lusername']) ? $_COOKIE['sso_lusername'] : false;
		$sso_user = (isset($_COOKIE['sso_username']) && $_COOKIE['sso_username']) ? $_COOKIE['sso_username'] : false;
		$sso_token = (isset($_COOKIE['sso_token']) && $_COOKIE['sso_token']) ? $_COOKIE['sso_token'] : false;
		$remote = isset($_SERVER['REMOTE_ADDR']) ? $_SERVER['REMOTE_ADDR'] : '';
		$server = isset($_SERVER['SERVER_NAME']) ? $_SERVER['SERVER_NAME'] : '';
		$sso_token_check = hash('sha256', $sso_user . ':'. $server. ':'. $remote .":". $sso_login);
		if ($sso_user && (strpos($sso_login, $sso_user ."_sso_") === 0))
		{
			if ($sso_token && hash_equals($sso_token_check, $sso_token))
			{
				define('SSO_USERNAME', $sso_user);
			}
		}
	}

	$conf['default_lang'] = 'auto';
	$conf['extra_session_security'] = true;
	$conf['autocomplete'] = 'default on';
	$conf['extra_login_security'] = true;
	$conf['owned_only'] = true;
	$conf['show_comments'] = true;
	$conf['show_advanced'] = false;
	$conf['show_system'] = false;
	$conf['min_password_length'] = 12;
	$conf['left_width'] = 200;
	$conf['theme'] = 'default';
	$conf['show_oids'] = false;
	$conf['max_rows'] = 30;
	$conf['max_chars'] = 50;
	$conf['use_xhtml_strict'] = false;
	$conf['help_base'] = 'https://www.postgresql.org/docs/%s/interactive/';
	$conf['ajax_refresh'] = 3;
	$conf['plugins'] = array();
	$conf['version'] = 19;

?>
